# SQLite dosya yolu
DB_PATH=./newgenc.db

# Upload dizini
UPLOAD_DIR=./uploads

# İzin verilen CORS originleri (virgülle ayrılmış)
ALLOWED_ORIGINS=https://app.siteadiniz.com
