PORT=8000

# JWT — güvenli bir secret üretmek için:
# node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))"
JWT_SECRET=BURAYA_GUCLU_RASTGELE_SECRET_YAZIN
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# Admin hesabı (ilk çalıştırmada seed ile oluşturulur)
